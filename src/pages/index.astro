    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Raleway', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    },
                    colors: {
                        jsos: {
                            purple: '#663399',  /* Exact Deep Purple from your WordPress stylesheet */
                            black: '#0C0910',   /* Exact Rich Black from your WordPress stylesheet */
                            grey: '#898989',    /* Exact Neutral Grey from your WordPress stylesheet */
                            darkgrey: '#141118',
                            light: '#ffffff'
                        }
                    },
                    animation: {
                        'fade-in-up': 'fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards',
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-glow': 'pulseGlow 4s ease-in-out infinite',
                    },
                    keyframes: {
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(24px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '0.2', transform: 'scale(1)' },
                            '50%': { opacity: '0.4', transform: 'scale(1.15)' },
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0C0910;
            color: #ffffff;
            overflow-x: hidden;
        }

        /* Replicating Custom CSS from JSOS WordPress: Transparent watermark headers */
        .watermark-container {
            position: relative;
        }
        .watermark-text {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
            white-space: nowrap;
            font-size: clamp(60px, 14vw, 180px);
            font-weight: 900;
            line-height: 1;
            font-family: 'Montserrat', sans-serif;
            color: transparent;
            -webkit-text-stroke: 1px rgba(102, 51, 153, 0.08);
            letter-spacing: 0.1em;
            pointer-events: none;
            user-select: none;
        }

        /* Glassmorphism card utilities */
        .glass-card {
            background: rgba(20, 17, 24, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
        }

        .glass-card:hover {
            border-color: rgba(102, 51, 153, 0.4);
            box-shadow: 0 20px 40px -10px rgba(102, 51, 153, 0.15);
        }

        /* Portfolio Captions Replicating "The Whit Group" Layout */
        .portfolio-grid-item {
            position: relative;
            overflow: hidden;
            border-radius: 16px;
        }
        .portfolio-image {
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .portfolio-grid-item:hover .portfolio-image {
            transform: scale(1.06);
        }
        .portfolio-overlay {
            background: linear-gradient(to top, rgba(12, 9, 16, 0.95) 0%, rgba(102, 51, 153, 0.85) 100%);
            opacity: 0;
            transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .portfolio-grid-item:hover .portfolio-overlay {
            opacity: 1;
        }

        /* Custom Scrollbar matching colors */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0C0910; }
        ::-webkit-scrollbar-thumb { background: #663399; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #8952c4; }

        /* Selection highlight */
        ::selection { background-color: #663399; color: #ffffff; }
    </style>
</head>
