---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JS Office Solutions | High-Performance Websites for Small Businesses">
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden bg-[#0C0910]">
        <canvas id="polygonCanvas" class="absolute inset-0 w-full h-full opacity-40"></canvas>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-jsos-black/40 to-jsos-black pointer-events-none"></div>
    </div>

    <a 
        href="https://wa.me/447000000000" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-16 h-16 rounded-full bg-[#25D366] text-white shadow-[0_4px_25px_rgba(37,211,102,0.4)] hover:bg-[#20ba5a] hover:scale-110 active:scale-95 transition-all duration-300 group"
        aria-label="Chat with us on WhatsApp"
    >
        <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
            <path d="M12.004 2c-5.51 0-9.99 4.48-9.99 9.99 0 2.008.593 3.878 1.614 5.451L2 22l4.71-1.552c1.512.93 3.286 1.472 5.187 1.472 5.51 0 10-4.48 10-9.99 0-5.51-4.49-9.99-10-9.99zm4.688 13.084c-.21.595-1.214 1.134-1.739 1.186-.464.046-.91.22-2.953-.594-2.614-1.042-4.264-3.717-4.394-3.891-.13-.174-1.052-1.401-1.052-2.671 0-1.27.653-1.894.885-2.154.23-.26.51-.326.68-.326.17 0 .341.002.49.01.15.009.351-.056.547.417.2.485.684 1.666.746 1.794.062.127.103.276.017.445-.086.17-.13.276-.256.425-.125.147-.263.329-.375.441-.125.126-.256.262-.11.513.146.251.648 1.071 1.392 1.734.96.855 1.762 1.12 2.013 1.246.252.126.398.105.547-.066.149-.172.639-.745.811-.998.171-.252.343-.211.577-.124.234.088 1.49.703 1.747.832.257.128.428.193.492.3.064.108.064.621-.146 1.216z"/>
        </svg>
        <span class="absolute right-20 bg-jsos-darkgrey border border-white/10 text-white text-xs font-bold px-3 py-2 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap shadow-xl pointer-events-none">
            Have a question? Chat now
        </span>
    </a>

    <nav class="fixed w-full z-50 bg-jsos-black/80 backdrop-blur-xl border-b border-white/5 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center lg:px-12">
            <a href="#" class="flex items-center gap-3 group" aria-label="JS Office Solutions Home">
                <div class="w-11 h-11 bg-jsos-purple rounded-xl flex items-center justify-center text-white font-extrabold text-xl group-hover:scale-105 transition-transform duration-300 shadow-[0_0_15px_rgba(102,51,153,0.4)]">
                    JS
                </div>
                <span class="text-2xl font-black tracking-tight text-white font-heading">
                    JS<span class="text-jsos-purpleLight">OS</span>
                </span>
            </a>
            
            <div class="hidden md:flex space-x-10 text-xs font-bold tracking-widest uppercase text-jsos-grey">
                <a href="#services" class="hover:text-white transition-colors py-2 relative group-link">What We Do</a>
                <a href="#blueprint" class="hover:text-white transition-colors py-2 relative group-link">The Blueprint</a>
                <a href="#process" class="hover:text-white transition-colors py-2 relative group-link">How It Works</a>
                <a href="#estimator" class="hover:text-white transition-colors py-2 relative group-link">Price Calculator</a>
                <a href="#portfolio" class="hover:text-white transition-colors py-2 relative group-link">Our Work</a>
            </div>
            
            <a href="#contact" class="hidden md:inline-flex items-center justify-center px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white transition-all bg-jsos-purple rounded-xl hover:bg-purple-700 hover:shadow-[0_0_25px_rgba(102,51,153,0.5)] transform hover:-translate-y-0.5 duration-300">
                LET'S TALK
            </a>

            <button class="md:hidden text-white p-2 focus:outline-none" id="mobileMenuButton" aria-label="Toggle Navigation Menu" aria-expanded="false">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>

        <div class="hidden transition-all duration-300" id="mobileMenu">
            <div class="px-6 pt-2 pb-8 bg-jsos-black border-b border-white/10 flex flex-col space-y-4 text-center shadow-2xl">
                <a href="#services" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">What We Do</a>
                <a href="#blueprint" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">The Blueprint</a>
                <a href="#process" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">How It Works</a>
                <a href="#estimator" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Price Calculator</a>
                <a href="#portfolio" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Our Work</a>
                <a href="#contact" class="bg-jsos-purple text-white py-3.5 rounded-xl font-bold uppercase tracking-wider hover:bg-purple-700 transition-colors">LET'S TALK</a>
            </div>
        </div>
    </nav>

    <main class="relative z-10">
        <section class="relative min-h-screen flex items-center justify-center pt-32 pb-24 overflow-hidden bg-transparent z-10 xl:px-12">
            <div class="absolute inset-0 z-0 pointer-events-none parallax-bg" data-speed="0.12">
                <div class="absolute top-1/4 left-1/4 w-[700px] h-[700px] bg-jsos-purple/10 rounded-full blur-[180px]"></div>
                <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-purple-900/10 rounded-full blur-[150px]"></div>
            </div>

            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-16 lg:gap-24 items-center w-full relative z-10">
                <div class="lg:col-span-7 text-left space-y-8 reveal-element">
                    <div class="inline-flex items-center gap-2.5 px-4.5 py-2 rounded-full bg-jsos-purple/15 border border-jsos-purple/30 shadow-[0_0_15px_rgba(102,51,153,0.1)]">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
                        <span class="text-xs font-bold uppercase tracking-widest text-jsos-purpleLight">Enterprise-Grade Performance</span>
                    </div>
                    
                    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.08] font-heading text-white flex flex-col justify-start min-h-[160px] sm:min-h-[180px] md:min-h-[220px] lg:min-h-[250px]">
                        <span>Websites built to</span>
                        <span class="min-h-[1.2em] block text-transparent bg-clip-text bg-gradient-to-r from-jsos-purpleLight via-purple-400 to-white font-black" id="typingText"></span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-jsos-grey max-w-2xl leading-relaxed font-medium">
                        We engineering ultra-fast, bespoke websites that capture regional search engine traffic and transform clicks into premium long-term clients.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-5 pt-2">
                        <a href="#contact" class="px-8 py-4.5 bg-jsos-purple text-white font-extrabold rounded-xl hover:bg-purple-700 hover:-translate-y-1 hover:shadow-[0_10px_40px_-10px_rgba(102,51,153,0.8)] active:translate-y-0 transition-all duration-300 text-center flex items-center justify-center gap-3 tracking-wider uppercase text-xs">
                            Get A Free Proposal
                            <i class="fa-solid fa-arrow-right animate-bounce-horizontal"></i>
                        </a>
                        <a href="#estimator" class="px-8 py-4.5 glass-card text-white font-extrabold rounded-xl hover:bg-white/10 hover:-translate-y-1 active:translate-y-0 transition-all duration-300 text-center text-xs uppercase tracking-wider">
                            Calculate Your Price
                        </a>
                    </div>
                    
                    <div class="flex items-center gap-6 text-xs text-jsos-darkGreyText font-medium pt-6 border-t border-white/5 max-w-xl">
                        <p class="flex items-center gap-2"><i class="fa-solid fa-check text-jsos-purpleLight"></i> No Upfront Hidden Costs</p>
                        <p class="flex items-center gap-2"><i class="fa-solid fa-check text-jsos-purpleLight"></i> Bespoke Essex Engineering</p>
                    </div>
                </div>

                <div class="lg:col-span-5 relative hidden lg:block reveal-element delay-200">
                    <div class="relative w-full aspect-square max-w-[480px] mx-auto interactive-hover-card rounded-3xl">
                        <div class="absolute inset-0 bg-jsos-purple/20 rounded-3xl rotate-3 blur-md z-0 transition-transform duration-500 card-glow-layer"></div>
                        <div class="absolute inset-2 glass-card rounded-3xl p-8 flex flex-col gap-6 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] border border-white/10 z-20 overflow-hidden">
                            <div class="flex items-center justify-between border-b border-white/5 pb-4">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                                </div>
                                <span class="text-[10px] px-3 py-1 bg-green-400/10 text-green-400 rounded-full font-bold tracking-wider uppercase border border-green-500/20">100% Mobile Optimized</span>
                            </div>
                            
                            <div class="font-mono text-sm space-y-4 flex-1 select-none text-jsos-grey leading-relaxed">
                                <p class="text-jsos-purpleLight font-bold">&lt;LocalBusiness&gt;</p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Fast Loading Speed:</span> <span class="text-green-400 font-bold">Excellent</span></p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Google Lighthouse SEO:</span> <span class="text-green-400 font-bold">100/100</span></p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Core Web Vitals:</span> <span class="text-green-400 font-bold">Passed</span></p>
                                <p class="text-jsos-purpleLight font-bold">&lt;/LocalBusiness&gt;</p>
                                
                                <div class="pt-6 border-t border-white/5 flex justify-between items-center text-[10px] uppercase tracking-wider font-sans font-bold text-jsos-darkGreyText">
                                    <span class="text-emerald-400 flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved"></i> Enterprise Secure
                                    </span>
                                    <span class="text-white">UK Maintained</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="services" class="py-40 relative bg-jsos-darkgrey/70 border-y border-white/5 overflow-hidden z-20 xl:px-12">
            <div class="absolute inset-0 pointer-events-none parallax-bg" data-speed="-0.05">
                <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-jsos-purple/5 rounded-full blur-[140px]"></div>
            </div>
            
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-32 reveal-element">
                    <span class="watermark-text">SERVICES</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">WHAT WE DELIVER</h2>
                    <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white font-heading relative z-10">Everything You Need to Win Online</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-10 lg:gap-12">
                    <div class="glass-card p-10 lg:p-12 rounded-2xl border border-white/5 relative overflow-hidden interactive-hover-card reveal-element">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-bolt text-xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Lightning-Fast Infrastructure</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm lg:text-base">
                            Most template configurations are weighted down by bad code and bulky plugins. We design websites cleanly from the engine up, scoring unmatched loading times that maximize client retention.
                        </p>
                    </div>

                    <div class="glass-card p-10 lg:p-12 rounded-2xl border border-white/5 relative overflow-hidden interactive-hover-card reveal-element delay-100">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-basket-shopping text-xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Seamless E-Commerce</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm lg:text-base">
                            Ready to collect immediate consumer deposits, secure digital client checkouts, or optimize scheduling logic? We deploy ultra-clean, high-availability booking frameworks explicitly built to convert.
                        </p>
                    </div>

                    <div class="glass-card p-10 lg:p-12 rounded-2xl border border-white/5 relative overflow-hidden interactive-hover-card reveal-element delay-200">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-shield-halved text-xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Bulletproof Systems Security</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm lg:text-base">
                            Leveraging enterprise systems engineering blueprints, we shield your hosting surface, eliminating server vulnerabilities and malicious script injections before they can start.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="blueprint" class="py-40 relative bg-gradient-to-br from-jsos-black via-[#130b1e] to-jsos-black overflow-hidden z-20 xl:px-12">
            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
                <div class="space-y-6 reveal-element">
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs">OUR STRICT FRAMEWORK</h2>
                    <h3 class="text-4xl md:text-5xl lg:text-6xl font-black text-white font-heading leading-tight">Built to Stand Alone. <br/>Engineered to Dominate.</h3>
                    <p class="text-jsos-grey font-medium leading-relaxed lg:text-base">
                        We don't use dragging templates, bloated themes, or cheap visual editors that produce messy code structures. We engineer custom architectures built to provide real speed, elite security, and visible local growth.
                    </p>
                    
                    <div class="space-y-5 pt-4">
                        <div class="flex gap-4 items-start">
                            <div class="w-6 h-6 rounded-full bg-jsos-purple/30 border border-jsos-purpleLight/40 flex items-center justify-center text-jsos-purpleLight mt-1 text-xs shrink-0"><i class="fa-solid fa-code"></i></div>
                            <div>
                                <h4 class="text-white font-bold text-base lg:text-lg">Hand-Coded Performance Integration</h4>
                                <p class="text-jsos-darkGreyText text-sm mt-1 lg:text-base">Semantic source files maximize browser readability scores, leading directly to premium search indexing priorities.</p>
                            </div>
                        </div>
                        <div class="flex gap-4 items-start">
                            <div class="w-6 h-6 rounded-full bg-jsos-purple/30 border border-jsos-purpleLight/40 flex items-center justify-center text-jsos-purpleLight mt-1 text-xs shrink-0"><i class="fa-solid fa-magnifying-glass"></i></div>
                            <div>
                                <h4 class="text-white font-bold text-base lg:text-lg">Bespoke Local Visibility Mechanics</h4>
                                <p class="text-jsos-darkGreyText text-sm mt-1 lg:text-base">Deep on-page metadata optimization engineered directly around competitive local regional query frameworks.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="relative grid grid-cols-2 gap-6 lg:gap-8 reveal-element">
                    <div class="space-y-6 lg:space-y-8">
                        <div class="glass-card p-8 rounded-2xl border border-white/5 translate-y-8">
                            <span class="text-4xl lg:text-5xl font-black text-jsos-purpleLight font-heading counter-value" data-target="100">%</span>
                            <p class="text-white font-bold text-sm lg:text-base mt-2">Data Sovereignty</p>
                            <p class="text-jsos-darkGreyText text-xs lg:text-sm mt-1">Total operational independence over your source configuration assets.</p>
                        </div>
                        <div class="glass-card p-8 rounded-2xl border border-white/5 translate-y-8">
                            <span class="text-4xl lg:text-5xl font-black text-jsos-purpleLight font-heading flex items-center">&lt;<span class="counter-value" data-target="400">0</span>ms</span>
                            <p class="text-white font-bold text-sm lg:text-base mt-2">Average Response</p>
                            <p class="text-jsos-darkGreyText text-xs lg:text-sm mt-1">Lightning response parameters on any mobile device viewport.</p>
                        </div>
                    </div>
                    <div class="space-y-6 lg:space-y-8">
                        <div class="glass-card p-8 rounded-2xl border border-white/5">
                            <span class="text-4xl lg:text-5xl font-black text-jsos-purpleLight font-heading counter-value" data-target="0">0</span>
                            <p class="text-white font-bold text-sm lg:text-base mt-2">Database Reliance</p>
                            <p class="text-jsos-darkGreyText text-xs lg:text-sm mt-1">Static build mechanics ensure zero security exploit surfaces.</p>
                        </div>
                        <div class="glass-card p-8 rounded-2xl border border-white/5">
                            <span class="text-4xl lg:text-5xl font-black text-jsos-purpleLight font-heading flex items-center"><span class="counter-value" data-target="24">0</span>/7</span>
                            <p class="text-white font-bold text-sm lg:text-base mt-2">Active Guarding</p>
                            <p class="text-jsos-darkGreyText text-xs lg:text-sm mt-1">Monitored deployments mean no broken updates over weekends.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="process" class="py-40 relative bg-jsos-black border-t border-white/5 z-20 xl:px-12">
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-28 reveal-element">
                    <span class="watermark-text">SIMPLE</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">OUR ROADMAP</h2>
                    <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white font-heading relative z-10">Getting Started is Simple</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-10 lg:gap-12 relative z-10">
                    <div class="glass-card p-8 lg:p-10 rounded-2xl border border-white/5 relative reveal-element">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-11 h-11 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)]">
                            1
                        </div>
                        <h4 class="text-xl lg:text-2xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Configure Your Scope</h4>
                        <p class="text-sm lg:text-base text-jsos-grey leading-relaxed font-medium">
                            Utilize our transparent blueprint investment module below to custom configure your operational requirements and scaling parameters in real time.
                        </p>
                    </div>

                    <div class="glass-card p-8 lg:p-10 rounded-2xl border border-white/5 relative reveal-element delay-100">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-11 h-11 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)]">
                            2
                        </div>
                        <h4 class="text-xl lg:text-2xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Lock In Parameters</h4>
                        <p class="text-sm lg:text-base text-jsos-grey leading-relaxed font-medium">
                            Submit your verified calculator dashboard report or connect via one-click WhatsApp. We'll verify your specifications through a straightforward consulting review session.
                        </p>
                    </div>

                    <div class="glass-card p-8 lg:p-10 rounded-2xl border border-white/5 relative reveal-element delay-200">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-11 h-11 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)]">
                            3
                        </div>
                        <h4 class="text-xl lg:text-2xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Hands-Off Production</h4>
                        <p class="text-sm lg:text-base text-jsos-grey leading-relaxed font-medium">
                            While we implement the clean architecture blueprint, execute edge optimization protocols, and lock down secure hosting paths, you remain completely focused on scaling business operations.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="estimator" class="py-40 relative bg-jsos-darkgrey/40 border-t border-white/5 z-20 xl:px-12">
            <div class="max-w-6xl mx-auto px-6">
                <div class="watermark-container text-center mb-24 reveal-element">
                    <span class="watermark-text">INVESTMENT</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">TRANSPARENT VALUE</h2>
                    <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white font-heading relative z-10">Build Your Deployment Plan</h3>
                </div>

                <div class="glass-card p-8 md:p-12 lg:p-16 rounded-3xl border border-white/10 space-y-10 relative overflow-hidden reveal-element">
                    <p class="text-center text-jsos-grey text-base lg:text-lg font-medium max-w-xl mx-auto">Adjust the operational parameters below to generate an analytical development estimate tailored to your company's scaling needs.</p>
                    
                    <div class="grid md:grid-cols-12 gap-12 lg:gap-16 pt-4 items-center">
                        <div class="md:col-span-7 space-y-10">
                            <div>
                                <label class="flex justify-between items-center text-xs font-bold uppercase tracking-widest text-white mb-4" id="pageLabel" for="pageRange">
                                    <span>Core Informational Pages:</span>
                                    <span class="text-jsos-purpleLight text-xl font-black bg-jsos-purple/10 border border-jsos-purple/30 px-4 py-1.5 rounded-lg" id="pageValue">5</span>
                                </label>
                                <div class="relative flex items-center py-2">
                                    <input type="range" min="1" max="25" value="5" class="w-full h-2 bg-white/10 rounded-lg appearance-none cursor-pointer accent-jsos-purpleLight focus:outline-none focus:ring-2 focus:ring-jsos-purpleLight/50" id="pageRange">
                                </div>
                                <div class="flex justify-between text-[10px] text-jsos-darkGreyText mt-2 font-bold tracking-wider uppercase">
                                    <span>1 Single Page</span>
                                    <span>12 Core Layouts</span>
                                    <span>25 Massive Platform</span>
                                </div>
                            </div>

                            <div class="space-y-4">
                                <span class="block text-xs font-bold uppercase tracking-widest text-white mb-2">Integrated Platform Functionality</span>
                                <div class="grid gap-4">
