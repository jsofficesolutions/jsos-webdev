    <script is:inline>
        document.getElementById('year').textContent = new Date().getFullYear();

        // Responsive Dropdown Mobile Drawer
        const mobileMenuButton = document.getElementById('mobileMenuButton');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuButton.addEventListener('click', () => {
            const expanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
            mobileMenuButton.setAttribute('aria-expanded', !expanded);
            mobileMenu.classList.toggle('hidden');
        });
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                mobileMenuButton.setAttribute('aria-expanded', 'false');
            });
        });

        // Elite Intersection Observer Rule Array for Global Viewport Animations
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible-active');
                    // Trigger numbers counters if the element contains metrics
                    if (entry.target.querySelectorAll('.counter-value').length > 0) {
                        triggerCounters(entry.target);
                    }
                }
            });
        }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('.reveal-element').forEach(element => revealObserver.observe(element));

        // Premium Numerical Auto-Counting Acceleration System
        function triggerCounters(parent) {
            parent.querySelectorAll('.counter-value').forEach(counter => {
                if (counter.classList.contains('counted')) return;
                counter.classList.add('counted');
                
                const target = parseInt(counter.getAttribute('data-target'));
                if (target === 0) {
                    counter.textContent = '0';
                    return;
                }
                
                let start = 0;
                const duration = 1500; // Time in ms
                const stepTime = Math.max(Math.floor(duration / target), 15);
                
                const timer = setInterval(() => {
                    start += Math.ceil(target / 40); // Accelerative scaling incrementation
                    if (start >= target) {
                        counter.textContent = target;
                        clearInterval(timer);
                    } else {
                        counter.textContent = start;
                    }
                }, stepTime);
            });
        }

        // Smooth Pure-JS High-Performance CSS Parallax Engine Engine 
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            document.querySelectorAll('.parallax-bg').forEach(bg => {
                const speed = parseFloat(bg.getAttribute('data-speed') || 0.1);
                const yPos = -(scrolled * speed);
                bg.style.transform = `translateY(${yPos}px) translateZ(0)`;
            });
        });

        // Intelligent Typography Loop Layout Engine
        const phraseArray = ["Attract Customers.", "Load Instantly.", "Dominate Local Search."];
        let count = 0, index = 0, currentText = "", letter = "";
        (function type() {
            if (count === phraseArray.length) count = 0;
            currentText = phraseArray[count];
            letter = currentText.slice(0, ++index);
            const target = document.getElementById('typingText');
            if(target) target.textContent = letter;
            if (letter.length === currentText.length) {
                setTimeout(() => { index = 0; count++; setTimeout(type, 1200); }, 2200);
            } else {
                setTimeout(type, 65);
            }
        }());

        // Automated Pricing Engine Calculator Setup
        const pageRange = document.getElementById('pageRange');
        const pageValue = document.getElementById('pageValue');
        const ecommerceOpt = document.getElementById('ecommerceOpt');
        const cmsOpt = document.getElementById('cmsOpt');
        const seoOpt = document.getElementById('seoOpt');
        const estimatedTotal = document.getElementById('estimatedTotal');
        const claimEstimateBtn = document.getElementById('claimEstimateBtn');
        const formMessage = document.getElementById('formMessage');

        function calculateEstimates() {
            const pages = parseInt(pageRange.value || 5);
            if(pageValue) pageValue.textContent = pages;
            let total = 450 + (pages * 130);
            if (ecommerceOpt.checked) total += 950;
            if (cmsOpt.checked) total += 600;
            if (seoOpt.checked) total += 350;
            if(estimatedTotal) estimatedTotal.textContent = "£" + total.toLocaleString('en-GB');
            return { pages, total, ecommerce: ecommerceOpt.checked, cms: cmsOpt.checked, seo: seoOpt.checked };
        }

        if(pageRange) {
            ['input', 'change'].forEach(evt => pageRange.addEventListener(evt, calculateEstimates));
            [ecommerceOpt, cmsOpt, seoOpt].forEach(opt => opt.addEventListener('change', calculateEstimates));
        }

        if(claimEstimateBtn) {
            claimEstimateBtn.addEventListener('click', (e) => {
                const config = calculateEstimates();
                if(formMessage) {
                    formMessage.value = `Hi JSOS! I configured our prospective target scope via your interactive layout generator tool:\n- Core Target Layouts: ${config.pages} Pages\n- Integrated Booking/Checkout: ${config.ecommerce ? 'Yes' : 'No'}\n- Management CMS Dashboard: ${config.cms ? 'Yes' : 'No'}\n- Deep Regional SEO Pack: ${config.seo ? 'Yes' : 'No'}\n\nGenerated Investment Target: £${config.total}. Let's run a full specification review.`;
                }
            });
        }

        // Seamless Portfolio UI Filtering Canvas Matrix Logic
        const filterBtns = document.querySelectorAll('.portfolio-filter-btn');
        const items = document.querySelectorAll('#portfolioContainer > div');
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => b.classList.remove('bg-jsos-purple', 'text-white'));
                filterBtns.forEach(b => b.classList.add('border-white/5', 'text-jsos-grey'));
                btn.classList.remove('border-white/5', 'text-jsos-grey');
                btn.classList.add('bg-jsos-purple', 'text-white');
                
                const filter = btn.getAttribute('data-filter');
                items.forEach(item => {
                    if(filter === 'all' || item.getAttribute('data-category') === filter) {
                        item.style.display = 'block';
                        setTimeout(() => item.style.opacity = '1', 50);
                    } else {
                        item.style.opacity = '0';
                        setTimeout(() => item.style.display = 'none', 300);
                    }
                });
            });
        });

        // Contact Capture State Funnel Handling
        const contactForm = document.getElementById('jsosContactForm');
        const formWrapper = document.getElementById('contactFormWrapper');
        const successState = document.getElementById('formSuccessState');
        const resetBtn = document.getElementById('resetFormBtn');
        if(contactForm) {
            contactForm.addEventListener('submit', (e) => {
                e.preventDefault();
                formWrapper.classList.add('hidden');
                successState.classList.remove('hidden');
            });
            resetBtn.addEventListener('click', () => {
                contactForm.reset();
                successState.classList.add('hidden');
                formWrapper.classList.remove('hidden');
                calculateEstimates();
            });
        }

        // Ambient Mouse Glow Positioning Tracking Logic
        document.querySelectorAll('.interactive-hover-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty('--mouse-x', `${x}px`);
                card.style.setProperty('--mouse-y', `${y}px`);
            });
        });

        // FIXED HIGH-VISIBILITY PARTICLE FIELDS CANVAS GENERATOR
        const canvas = document.getElementById('polygonCanvas');
        const ctx = canvas.getContext('2d');
        let points = [];
        const numPoints = 50;
        const maxDist = 160;

        function initCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            points = [];
            for (let i = 0; i < numPoints; i++) {
                points.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.35,
                    vy: (Math.random() - 0.5) * 0.35,
                    r: Math.random() * 2 + 1.5
                });
            }
        }

        function drawPoints() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Connect lines between intersecting paths
            for (let i = 0; i < points.length; i++) {
                for (let j = i + 1; j < points.length; j++) {
                    const dist = Math.hypot(points[i].x - points[j].x, points[i].y - points[j].y);
                    if (dist < maxDist) {
                        const alpha = (1 - dist / maxDist) * 0.22;
                        ctx.strokeStyle = `rgba(192, 132, 252, ${alpha})`; // Bright purple lines
                        ctx.lineWidth = 0.9;
                        ctx.beginPath();
                        ctx.moveTo(points[i].x, points[i].y);
                        ctx.lineTo(points[j].x, points[j].y);
                        ctx.stroke();
                    }
                }
            }

            // Draw individual dynamic nodes
            points.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;
                
                if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                
                ctx.fillStyle = 'rgba(168, 85, 247, 0.55)'; // Distinct amethyst nodes
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fill();
            });
            
            requestAnimationFrame(drawPoints);
        }

        window.addEventListener('resize', initCanvas);
        initCanvas();
        drawPoints();
    </script>
</Layout>
