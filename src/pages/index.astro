---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JS Office Solutions | Web Development">
	
	<nav class="fixed w-full z-50 bg-jsos-black/90 backdrop-blur-md border-b border-jsos-darkgrey">
		<div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
			<div class="text-2xl font-bold tracking-tighter">
				<span class="text-jsos-light">JS</span><span class="text-jsos-purple">OS</span>
			</div>
			<div class="space-x-8 text-sm font-medium text-jsos-grey hidden md:block">
				<a href="#services" class="hover:text-jsos-purple transition-colors">Services</a>
				<a href="#tech" class="hover:text-jsos-purple transition-colors">Capabilities</a>
				<a href="#contact" class="hover:text-jsos-purple transition-colors">Contact</a>
			</div>
			<a href="#contact" class="bg-jsos-purple text-white px-5 py-2 rounded-md text-sm font-bold hover:bg-purple-800 transition-colors">
				Let's Talk
			</a>
		</div>
	</nav>

	<header class="relative pt-40 pb-32 overflow-hidden flex flex-col items-center justify-center min-h-[90vh]">
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-jsos-purple/20 via-jsos-black to-jsos-black -z-10"></div>
		
		<div class="max-w-4xl mx-auto px-6 text-center z-10">
			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-8">
				Digital Excellence for <br />
				<span class="text-transparent bg-clip-text bg-gradient-to-r from-jsos-purple to-purple-400">
					Small Businesses.
				</span>
			</h1>
			<p class="text-xl text-jsos-grey mb-12 max-w-2xl mx-auto leading-relaxed">
				JS Office Solutions crafts lightning-fast, bespoke websites tailored to elevate brands. We build premium digital experiences that convert.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="#contact" class="px-8 py-4 bg-jsos-purple text-white font-bold rounded-md hover:bg-purple-800 transition-all shadow-[0_0_20px_rgba(102,51,153,0.4)]">
					Start Your Project
				</a>
				<a href="#services" class="px-8 py-4 bg-jsos-darkgrey text-white font-bold rounded-md hover:bg-gray-800 border border-jsos-grey/20 transition-all">
					Explore Services
				</a>
			</div>
		</div>
	</header>

	<section id="services" class="py-32 bg-jsos-darkgrey">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-20">
				<h2 class="text-3xl md:text-5xl font-bold mb-4">Uncompromising Quality.</h2>
				<p class="text-jsos-grey text-lg max-w-2xl mx-auto">We engineer solutions from the ground up, avoiding bloated page-builders to ensure your customers get a flawless experience.</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<div class="bg-jsos-black p-10 rounded-xl border border-jsos-grey/10 hover:border-jsos-purple/50 transition-colors group">
					<div class="w-12 h-12 bg-jsos-purple/20 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<svg class="w-6 h-6 text-jsos-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Custom Web Design</h3>
					<p class="text-jsos-grey leading-relaxed">Bespoke interfaces designed around conversion metrics, completely replacing standard cookie-cutter industry templates.</p>
				</div>

				<div class="bg-jsos-black p-10 rounded-xl border border-jsos-grey/10 hover:border-jsos-purple/50 transition-colors group">
					<div class="w-12 h-12 bg-jsos-purple/20 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<svg class="w-6 h-6 text-jsos-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Performance Engineered</h3>
					<p class="text-jsos-grey leading-relaxed">Built using modern component-driven setups to guarantee extreme load speeds, giving you an immediate SEO advantage.</p>
				</div>

				<div class="bg-jsos-black p-10 rounded-xl border border-jsos-grey/10 hover:border-jsos-purple/50 transition-colors group">
					<div class="w-12 h-12 bg-jsos-purple/20 rounded-lg flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
						<svg class="w-6 h-6 text-jsos-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
					</div>
					<h3 class="text-xl font-bold mb-3">Responsive Structure</h3>
					<p class="text-jsos-grey leading-relaxed">Perfect layout scaling across every form factor, ensuring mobile users receive an application-like experience.</p>
				</div>
			</div>
		</div>
	</section>

	<section id="tech" class="py-32 bg-jsos-black border-y border-jsos-grey/10">
		<div class="max-w-7xl mx-auto px-6 text-center">
			<h2 class="text-3xl font-bold mb-6">Capabilities & Technology Stack</h2>
			<p class="text-jsos-grey mb-16 max-w-2xl mx-auto">We use high-performance architectures that eliminate slow data bottlenecks and legacy infrastructure issues.</p>
			
			<div class="flex flex-wrap justify-center gap-12 items-center opacity-70">
				<div class="flex items-center gap-2 text-xl font-bold tracking-tight">Astro Framework</div>
				<div class="flex items-center gap-2 text-xl font-bold tracking-tight">Tailwind CSS Engine</div>
				<div class="flex items-center gap-2 text-xl font-bold tracking-tight">React Integration</div>
				<div class="flex items-center gap-2 text-xl font-bold tracking-tight">Cloudflare Architecture</div>
			</div>
		</div>
	</section>

	<footer id="contact" class="bg-jsos-darkgrey pt-32 pb-10">
		<div class="max-w-4xl mx-auto px-6 text-center mb-32">
			<h2 class="text-4xl md:text-6xl font-bold mb-6">Let’s launch your project.</h2>
			<p class="text-xl text-jsos-grey mb-10">Ready to drop the bulky page builders? Contact us today to see how a high-utility engineered site can transform your leads.</p>
			<a href="mailto:info@jsos.uk" class="inline-block px-10 py-5 bg-jsos-purple text-white font-bold text-lg rounded-md hover:bg-purple-800 transition-all">
				info@jsos.uk
			</a>
		</div>

		<div class="max-w-7xl mx-auto px-6 border-t border-jsos-grey/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-4">
			<div class="text-xl font-bold">
				<span class="text-jsos-light">JS</span><span class="text-jsos-purple">OS</span>
			</div>
			<p class="text-jsos-grey text-sm">© {new Date().getFullYear()} JS Office Solutions. All rights reserved.</p>
		</div>
	</footer>

</Layout>
