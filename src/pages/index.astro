---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JS Office Solutions | High-Performance Websites for Small Businesses">
    <div class="fixed inset-0 z-0 pointer-events-none">
        <canvas id="polygonCanvas" class="w-full h-full opacity-20"></canvas>
    </div>

    <a 
        href="https://wa.me/447000000000" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-jsos-purple text-white shadow-[0_4px_20px_rgba(102,51,153,0.5)] hover:bg-purple-700 hover:scale-110 transition-all duration-300 group"
        aria-label="Chat with us on WhatsApp"
    >
        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.717-1.456L0 24zm6.59-4.846c1.66.986 3.288 1.481 4.717 1.482 5.433-.002 9.85-4.425 9.853-9.86.002-2.634-1.02-5.11-2.881-6.974-1.86-1.864-4.332-2.887-6.969-2.889-5.437 0-9.854 4.423-9.857 9.86-.001 1.96.514 3.791 1.572 5.324l-.973 3.548 3.638-.953zM16.945 13.9c-.3-.15-1.775-.875-2.046-.975-.27-.1-.466-.15-.66.15-.194.3-.75.95-.92 1.14-.17.19-.34.215-.64.065-1.288-.644-2.13-1.127-2.966-2.564-.22-.378.22-.35.63-1.176.07-.15.035-.28-.015-.38-.05-.1-.466-1.125-.64-1.54-.17-.41-.357-.355-.488-.362-.127-.008-.273-.01-.42-.01-.147 0-.385.055-.587.275-.2.22-.765.75-.765 1.83 0 1.08.785 2.12.895 2.27.11.15 1.543 2.354 3.74 3.302 1.147.496 1.7.593 2.306.503.662-.1 1.775-.725 2.025-1.425.25-.7.25-1.3.175-1.425-.075-.125-.275-.2-.575-.35z"/>
        </svg>
        <span class="absolute right-16 bg-jsos-darkgrey border border-white/10 text-white text-xs font-bold px-3 py-2 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap shadow-xl pointer-events-none">
            Have a question? Chat now
        </span>
    </a>

    <nav class="fixed w-full z-50 bg-jsos-black/90 backdrop-blur-xl border-b border-white/10 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 bg-jsos-purple rounded-xl flex items-center justify-center text-white font-extrabold text-xl group-hover:scale-105 transition-transform duration-300 shadow-[0_0_15px_rgba(102,51,153,0.4)]">
                    JS
                </div>
                <span class="text-2xl font-black tracking-tight text-white font-heading">
                    JS<span class="text-jsos-purpleLight">OS</span>
                </span>
            </a>
            
            <div class="hidden md:flex space-x-8 text-sm font-bold tracking-wider uppercase text-jsos-grey">
                <a href="#services" class="hover:text-white transition-colors py-2">What We Do</a>
                <a href="#process" class="hover:text-white transition-colors py-2">How It Works</a>
                <a href="#estimator" class="hover:text-white transition-colors py-2">Price Calculator</a>
                <a href="#portfolio" class="hover:text-white transition-colors py-2">Our Work</a>
            </div>
            
            <a href="#contact" class="hidden md:inline-flex items-center justify-center px-6 py-3 text-sm font-bold uppercase tracking-wider text-white transition-all bg-jsos-purple rounded-xl hover:bg-purple-700 hover:shadow-[0_0_25px_rgba(102,51,153,0.5)] transform hover:-translate-y-0.5 duration-300">
                LET'S TALK
            </a>

            <button class="md:hidden text-white p-2 focus:outline-none" id="mobileMenuButton" aria-label="Toggle Menu">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>

        <div class="hidden" id="mobileMenu">
            <div class="px-6 pt-2 pb-8 bg-jsos-black border-b border-white/10 flex flex-col space-y-4 text-center shadow-2xl">
                <a href="#services" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">What We Do</a>
                <a href="#process" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">How It Works</a>
                <a href="#estimator" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Price Calculator</a>
                <a href="#portfolio" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Our Work</a>
                <a href="#contact" class="bg-jsos-purple text-white py-3.5 rounded-xl font-bold uppercase tracking-wider hover:bg-purple-700 transition-colors">LET'S TALK</a>
            </div>
        </div>
    </nav>

    <main class="relative z-10">
        <section class="relative min-h-screen flex items-center justify-center pt-28 pb-20 overflow-hidden">
            <div class="absolute top-1/4 left-1/4 w-[600px] h-[600px] bg-jsos-purple/15 rounded-full blur-[160px] pointer-events-none"></div>

            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-16 items-center">
                <div class="lg:col-span-7 text-left space-y-8">
                    <div class="inline-flex items-center gap-2.5 px-4.5 py-2 rounded-full bg-jsos-purple/15 border border-jsos-purple/30">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
                        <span class="text-xs font-bold uppercase tracking-wider text-jsos-purpleLight">Built For Business Growth</span>
                    </div>
                    
                    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.08] font-heading text-white">
                        Websites built to <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-jsos-purpleLight via-purple-300 to-white" id="typingText"></span><span class="text-jsos-purpleLight font-light">|</span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-jsos-grey max-w-xl leading-relaxed font-medium">
                        We build ultra-fast, custom websites that turn local search traffic into paying clients. Say goodbye to slow templates that frustrate your visitors.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-5 pt-2">
                        <a href="#contact" class="px-8 py-4.5 bg-jsos-purple text-white font-extrabold rounded-xl hover:bg-purple-700 hover:-translate-y-1 hover:shadow-[0_10px_40px_-10px_rgba(102,51,153,0.8)] transition-all duration-300 text-center flex items-center justify-center gap-3 tracking-wider uppercase text-sm">
                            Get A Free Proposal
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>
                        <a href="#estimator" class="px-8 py-4.5 glass-card text-white font-extrabold rounded-xl hover:bg-white/10 transition-all duration-300 text-center text-sm uppercase tracking-wider">
                            Calculate Your Price
                        </a>
                    </div>
                    <p class="text-xs text-jsos-darkGreyText font-medium italic pl-1">
                        * No upfront hidden costs. Custom code built right here in Essex.
                    </p>
                </div>

                <div class="lg:col-span-5 relative hidden lg:block animate-float">
                    <div class="relative w-full aspect-square max-w-[480px] mx-auto">
                        <div class="absolute inset-2 glass-card rounded-3xl p-8 flex flex-col gap-5 shadow-2xl overflow-hidden z-20">
                            <div class="flex items-center justify-between border-b border-white/10 pb-4">
                                <div class="flex items-center gap-2">
                                    <span class="w-3.5 h-3.5 rounded-full bg-red-500"></span>
                                    <span class="w-3.5 h-3.5 rounded-full bg-yellow-500"></span>
                                    <span class="w-3.5 h-3.5 rounded-full bg-green-500"></span>
                                </div>
                                <span class="text-xs px-3 py-1 bg-green-400/10 text-green-400 rounded-full font-bold">100% Mobile Optimized</span>
                            </div>
                            <div class="font-mono text-sm space-y-4 flex-1 select-none text-jsos-grey leading-relaxed">
                                <p class="text-jsos-purpleLight font-bold">&lt;LocalBusiness&gt;</p>
                                <p class="text-blue-300 pl-4">Fast Loading Speed: <span class="text-green-400 font-bold">Excellent</span></p>
                                <p class="text-blue-300 pl-4">Google Search SEO: <span class="text-green-400 font-bold">Optimized</span></p>
                                <p class="text-blue-300 pl-4">Secure Hosting: <span class="text-green-400 font-bold">Included</span></p>
                                <p class="text-jsos-purpleLight font-bold">&lt;/LocalBusiness&gt;</p>
                                <div class="pt-6 border-t border-white/10 flex justify-between items-center text-[11px]">
                                    <span class="text-emerald-400 font-bold flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved"></i> Enterprise-Grade Security
                                    </span>
                                    <span class="text-white font-semibold">Based in Essex</span>
                                </div>
                            </div>
                        </div>
                        <div class="absolute inset-0 bg-jsos-purple/20 rounded-3xl rotate-6 blur-sm z-10"></div>
                    </div>
                </div>
            </div>
        </section>

        <section id="services" class="py-32 relative bg-jsos-darkgrey/40">
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-24">
                    <span class="watermark-text">SERVICES</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-sm mb-4">WHAT WE DELIVER</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Everything You Need to Win Online</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    <div class="glass-card p-10 rounded-2xl transition-all duration-300 group border border-white/5 relative overflow-hidden">
                        <div class="w-16 h-16 bg-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
                            <i class="fa-solid fa-bolt text-2xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white">Lightning-Fast Sites</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium">
                            Most business sites are bogged down by clunky, outdated plugins. We custom-code your site from the ground up so it loads instantly on every smartphone, ensuring you never lose a customer to a slow page load.
                        </p>
                    </div>

                    <div class="glass-card p-10 rounded-2xl transition-all duration-300 group border border-white/5 relative overflow-hidden">
                        <div class="w-16 h-16 bg-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
                            <i class="fa-solid fa-basket-shopping text-2xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white">Seamless Online Shops</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium">
                            Ready to accept payments or manage bookings online? We integrate secure checkout flows and scheduling systems right into your site, making it effortless for your clients to do business with you.
                        </p>
                    </div>

                    <div class="glass-card p-10 rounded-2xl transition-all duration-300 group border border-white/5 relative overflow-hidden">
                        <div class="w-16 h-16 bg-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300">
                            <i class="fa-solid fa-lock text-2xl text-jsos-purpleLight"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white">Bulletproof Security</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium">
                            Leveraging our background in IT systems administration, we lock down your site to make it practically immune to hacking attempts. Sleep easy knowing your customer data and business assets remain perfectly safe.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="process" class="py-32 relative bg-jsos-black border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-20">
                    <span class="watermark-text">SIMPLE</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-sm mb-4">OUR ROADMAP</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Getting Started is Simple</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-8 relative">
                    <div class="glass-card p-8 rounded-2xl border border-white/10 relative">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/30 text-lg">
                            1
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading">Run an Estimate</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed">
                            Use the transparent blueprint estimator below to custom configure your page requirements and scale options in real time.
                        </p>
                    </div>

                    <div class="glass-card p-8 rounded-2xl border border-white/10 relative">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/30 text-lg">
                            2
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading">Claim with 1-Click</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed">
                            Submit your dashboard calculation or drop a text over WhatsApp. We'll set up a short, no-nonsense review session.
                        </p>
                    </div>

                    <div class="glass-card p-8 rounded-2xl border border-white/10 relative">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/30 text-lg">
                            3
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading">Hands-Off Launch</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed">
                            We write clean code, map out local SEO parameters, and secure the server landscape. You focus completely on running your business.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="estimator" class="py-32 relative bg-jsos-darkgrey/20 border-t border-white/5">
            <div class="max-w-4xl mx-auto px-6">
                <div class="watermark-container text-center mb-16">
                    <span class="watermark-text">PRICING</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-sm mb-4">TRANSPARENT VALUE</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Build Your Plan</h3>
                </div>

                <div class="glass-card p-8 md:p-12 rounded-3xl border border-white/10 space-y-8">
                    <p class="text-center text-jsos-grey text-base font-medium">Adjust the configuration below to view a ballpark estimate for your brand new custom website.</p>
                    
                    <div class="grid md:grid-cols-2 gap-10 pt-4">
                        <div class="space-y-8">
                            <div>
                                <label class="block text-sm font-bold uppercase tracking-wider text-white mb-3" id="pageLabel">
                                    Number of Core Pages: <span class="text-jsos-purpleLight text-lg font-black" id="pageValue">5</span>
                                </label>
                                <div class="relative flex items-center py-2">
                                    <input type="range" min="1" max="25" value="5" class="w-full h-2.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-jsos-purpleLight focus:outline-none focus:ring-2 focus:ring-jsos-purpleLight/50" id="pageRange">
                                </div>
                                <div class="flex justify-between text-xs text-jsos-grey mt-1 font-bold">
                                    <span>1 PAGE</span>
                                    <span>12 PAGES</span>
                                    <span>25 PAGES</span>
                                </div>
                            </div>

                            <div class="space-y-4">
                                <span class="block text-sm font-bold uppercase tracking-wider text-white mb-1">Optional Add-ons</span>
                                <div class="space-y-3.5">
                                    <label class="flex items-center gap-4 p-4.5 bg-white/[0.02] hover:bg-white/[0.05] border border-white/10 hover:border-jsos-purpleLight/40 rounded-xl cursor-pointer transition-all duration-200 select-none">
                                        <input type="checkbox" id="ecommerceOpt" class="w-5 h-5 rounded text-jsos-purple accent-jsos-purpleLight cursor-pointer">
                                        <div class="flex-1">
                                            <span class="block text-sm font-bold text-white leading-tight">Online Store & Booking Setup</span>
                                            <span class="block text-xs text-jsos-grey font-medium mt-0.5">+£950 Add-on</span>
                                        </div>
                                    </label>
                                    
                                    <label class="flex items-center gap-4 p-4.5 bg-white/[0.02] hover:bg-white/[0.05] border border-white/10 hover:border-jsos-purpleLight/40 rounded-xl cursor-pointer transition-all duration-200 select-none">
                                        <input type="checkbox" id="cmsOpt" class="w-5 h-5 rounded text-jsos-purple accent-jsos-purpleLight cursor-pointer">
                                        <div class="flex-1">
                                            <span class="block text-sm font-bold text-white leading-tight">Content Editing Dashboard</span>
                                            <span class="block text-xs text-jsos-grey font-medium mt-0.5">+£600 Add-on</span>
                                        </div>
                                    </label>
                                    
                                    <label class="flex items-center gap-4 p-4.5 bg-white/[0.02] hover:bg-white/[0.05] border border-white/10 hover:border-jsos-purpleLight/40 rounded-xl cursor-pointer transition-all duration-200 select-none">
                                        <input type="checkbox" id="seoOpt" checked class="w-5 h-5 rounded text-jsos-purple accent-jsos-purpleLight cursor-pointer">
                                        <div class="flex-1">
                                            <span class="block text-sm font-bold text-white leading-tight">Local Search Setup & SEO Package</span>
                                            <span class="block text-xs text-jsos-grey font-medium mt-0.5">+£350 Add-on</span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="bg-jsos-purple/15 border border-jsos-purple/40 rounded-2xl p-8 md:p-10 flex flex-col justify-between items-center text-center">
                            <div class="w-full space-y-4">
                                <span class="text-xs uppercase tracking-widest text-jsos-purpleLight font-black block">Estimated Investment</span>
                                <span class="text-5xl md:text-6xl font-black font-heading tracking-tight text-white block my-1 animate-pulse" id="estimatedTotal">£1,450</span>
                                <p class="text-sm text-jsos-grey leading-relaxed max-w-[240px] mx-auto font-medium">Includes managed cloud hosting setup and speed optimizations.</p>
                            </div>
                            <a href="#contact" id="claimEstimateBtn" class="w-full mt-8 py-4 bg-jsos-purple text-white font-extrabold rounded-xl hover:bg-purple-700 hover:shadow-[0_0_20px_rgba(102,51,153,0.5)] transition-all text-center text-sm uppercase tracking-wider">
                                Lock In This Estimate
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="portfolio" class="py-32 relative bg-jsos-black border-y border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-16">
                    <span class="watermark-text">PORTFOLIO</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-sm mb-4">OUR WORK</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Built For Local Leaders</h3>
                </div>

                <div class="flex flex-wrap justify-center gap-4 mb-16">
                    <button class="portfolio-filter-btn px-6 py-2.5 rounded-full font-bold text-sm tracking-wider uppercase border border-jsos-purple bg-jsos-purple text-white transition-all duration-300" data-filter="all">All Projects</button>
                    <button class="portfolio-filter-btn px-6 py-2.5 rounded-full font-bold text-sm tracking-wider uppercase border border-white/10 text-jsos-grey hover:border-white hover:text-white transition-all duration-300" data-filter="custom">Business Websites</button>
                    <button class="portfolio-filter-btn px-6 py-2.5 rounded-full font-bold text-sm tracking-wider uppercase border border-white/10 text-jsos-grey hover:border-white hover:text-white transition-all duration-300" data-filter="ecommerce">E-Commerce</button>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="portfolioContainer">
                    <div class="portfolio-grid-item border border-white/10 relative group cursor-pointer h-[380px]" data-category="custom">
                        <div class="w-full h-full bg-gradient-to-br from-purple-950 to-black absolute inset-0 opacity-40"></div>
                        <div class="portfolio-overlay absolute inset-0 flex flex-col justify-end p-8">
                            <strong class="text-2xl text-white font-heading tracking-wide">Winters Recreation</strong>
                            <p class="text-jsos-purpleLight font-bold mt-1.5 uppercase text-xs tracking-wider">High-Speed Business Showcase</p>
                        </div>
                    </div>
                    <div class="portfolio-grid-item border border-white/10 relative group cursor-pointer h-[380px]" data-category="ecommerce">
                        <div class="w-full h-full bg-gradient-to-br from-indigo-950 to-black absolute inset-0 opacity-40"></div>
                        <div class="portfolio-overlay absolute inset-0 flex flex-col justify-end p-8">
                            <strong class="text-2xl text-white font-heading tracking-wide">Coast to Coast Storage</strong>
                            <p class="text-jsos-purpleLight font-bold mt-1.5 uppercase text-xs tracking-wider">Secure Booking & Payments Hub</p>
                        </div>
                    </div>
                    <div class="portfolio-grid-item border border-white/10 relative group cursor-pointer h-[380px]" data-category="custom">
                        <div class="w-full h-full bg-gradient-to-br from-violet-950 to-black absolute inset-0 opacity-40"></div>
                        <div class="portfolio-overlay absolute inset-0 flex flex-col justify-end p-8">
                            <strong class="text-2xl text-white font-heading tracking-wide">Mayfield Homes</strong>
                            <p class="text-jsos-purpleLight font-bold mt-1.5 uppercase text-xs tracking-wider">Local Real Estate Platform</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="approach" class="py-32 relative bg-jsos-black">
            <div class="max-w-5xl mx-auto px-6 text-center space-y-12">
                <div class="watermark-container mb-12">
                    <span class="watermark-text">THE DIFFERENCE</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-sm mb-4">OUR BLUEPRINT</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Modern Code.<br/>Real Business Growth.</h3>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8 text-left">
                    <div class="glass-card p-8 rounded-2xl border border-white/10">
                        <div class="text-4xl text-jsos-purpleLight mb-5"><i class="fa-solid fa-mobile-screen-button"></i></div>
                        <h4 class="text-lg font-bold font-heading mb-3 text-white">Mobile-First Build</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed font-medium">Over 60% of your local clients look you up from a phone. Your site will be flawlessly responsive, fast-loading, and easily actionable on any handheld device.</p>
                    </div>

                    <div class="glass-card p-8 rounded-2xl border border-white/10">
                        <div class="text-4xl text-jsos-purpleLight mb-5"><i class="fa-solid fa-magnifying-glass-arrow-right"></i></div>
                        <h4 class="text-lg font-bold font-heading mb-3 text-white">Google Rank Ready</h4>
