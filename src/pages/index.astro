---
import Layout from '../layouts/Layout.astro';
---

<Layout title="JS Office Solutions | High-Performance Websites for Small Businesses">
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
        <canvas id="polygonCanvas" class="w-full h-full opacity-25 transition-opacity duration-1000"></canvas>
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-jsos-black/50 to-jsos-black pointer-events-none"></div>
    </div>

    <a 
        href="https://wa.me/447000000000" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-jsos-purple text-white shadow-[0_0_20px_rgba(102,51,153,0.6)] hover:bg-purple-700 hover:scale-110 active:scale-95 transition-all duration-300 group"
        aria-label="Chat with us on WhatsApp"
    >
        <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.717-1.456L0 24zm6.59-4.846c1.66.986 3.288 1.481 4.717 1.482 5.433-.002 9.85-4.425 9.853-9.86.002-2.634-1.02-5.11-2.881-6.974-1.86-1.864-4.332-2.887-6.969-2.889-5.437 0-9.854 4.423-9.857 9.86-.001 1.96.514 3.791 1.572 5.324l-.973 3.548 3.638-.953zM16.945 13.9c-.3-.15-1.775-.875-2.046-.975-.27-.1-.466-.15-.66.15-.194.3-.75.95-.92 1.14-.17.19-.34.215-.64.065-1.288-.644-2.13-1.127-2.966-2.564-.22-.378.22-.35.63-1.176.07-.15.035-.28-.015-.38-.05-.1-.466-1.125-.64-1.54-.17-.41-.357-.355-.488-.362-.127-.008-.273-.01-.42-.01-.147 0-.385.055-.587.275-.2.22-.765.75-.765 1.83 0 1.08.785 2.12.895 2.27.11.15 1.543 2.354 3.74 3.302 1.147.496 1.7.593 2.306.503.662-.1 1.775-.725 2.025-1.425.25-.7.25-1.3.175-1.425-.075-.125-.275-.2-.575-.35z"/>
        </svg>
        <span class="absolute right-18 bg-jsos-darkgrey border border-white/10 text-white text-xs font-bold px-3 py-2 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap shadow-xl pointer-events-none">
            Have a question? Chat now
        </span>
    </a>

    <nav class="fixed w-full z-50 bg-jsos-black/80 backdrop-blur-xl border-b border-white/5 transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-6 py-5 flex justify-between items-center">
            <a href="#" class="flex items-center gap-3 group" aria-label="JS Office Solutions Home">
                <div class="w-11 h-11 bg-jsos-purple rounded-xl flex items-center justify-center text-white font-extrabold text-xl group-hover:scale-105 transition-transform duration-300 shadow-[0_0_15px_rgba(102,51,153,0.4)]">
                    JS
                </div>
                <span class="text-2xl font-black tracking-tight text-white font-heading">
                    JS<span class="text-jsos-purpleLight">OS</span>
                </span>
            </a>
            
            <div class="hidden md:flex space-x-8 text-xs font-bold tracking-widest uppercase text-jsos-grey">
                <a href="#services" class="hover:text-white transition-colors py-2 relative group-link">What We Do</a>
                <a href="#blueprint" class="hover:text-white transition-colors py-2 relative group-link">The Blueprint</a>
                <a href="#process" class="hover:text-white transition-colors py-2 relative group-link">How It Works</a>
                <a href="#estimator" class="hover:text-white transition-colors py-2 relative group-link">Price Calculator</a>
                <a href="#portfolio" class="hover:text-white transition-colors py-2 relative group-link">Our Work</a>
            </div>
            
            <a href="#contact" class="hidden md:inline-flex items-center justify-center px-6 py-3 text-xs font-bold uppercase tracking-widest text-white transition-all bg-jsos-purple rounded-xl hover:bg-purple-700 hover:shadow-[0_0_25px_rgba(102,51,153,0.5)] transform hover:-translate-y-0.5 duration-300">
                LET'S TALK
            </a>

            <button class="md:hidden text-white p-2 focus:outline-none" id="mobileMenuButton" aria-label="Toggle Navigation Menu" aria-expanded="false">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>

        <div class="hidden transition-all duration-300" id="mobileMenu">
            <div class="px-6 pt-2 pb-8 bg-jsos-black border-b border-white/10 flex flex-col space-y-4 text-center shadow-2xl">
                <a href="#services" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">What We Do</a>
                <a href="#blueprint" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">The Blueprint</a>
                <a href="#process" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">How It Works</a>
                <a href="#estimator" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Price Calculator</a>
                <a href="#portfolio" class="text-lg font-bold text-white py-2.5 hover:text-jsos-purpleLight">Our Work</a>
                <a href="#contact" class="bg-jsos-purple text-white py-3.5 rounded-xl font-bold uppercase tracking-wider hover:bg-purple-700 transition-colors">LET'S TALK</a>
            </div>
        </div>
    </nav>

    <main class="relative z-10">
        <section class="relative min-h-screen flex items-center justify-center pt-28 pb-20 overflow-hidden bg-jsos-black">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(102,51,153,0.15)_0%,transparent_70%)] pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-16 items-center w-full relative z-10">
                <div class="lg:col-span-7 text-left space-y-8 animate-on-scroll fade-in-left">
                    <div class="inline-flex items-center gap-2.5 px-4.5 py-2 rounded-full bg-jsos-purple/15 border border-jsos-purple/30 shadow-[0_0_15px_rgba(102,51,153,0.1)]">
                        <span class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse"></span>
                        <span class="text-xs font-bold uppercase tracking-widest text-jsos-purpleLight">Enterprise-Grade Performance</span>
                    </div>
                    
                    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.05] font-heading text-white">
                        Websites built to <br />
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-jsos-purpleLight via-purple-400 to-white font-black" id="typingText"></span><span class="text-jsos-purpleLight font-light animate-pulse">|</span>
                    </h1>
                    
                    <p class="text-lg md:text-xl text-jsos-grey max-w-xl leading-relaxed font-medium">
                        We engineering ultra-fast, bespoke websites that capture regional search engine traffic and transform clicks into premium long-term clients.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-5 pt-2">
                        <a href="#contact" class="px-8 py-4.5 bg-jsos-purple text-white font-extrabold rounded-xl hover:bg-purple-700 hover:-translate-y-1 hover:shadow-[0_10px_40px_-10px_rgba(102,51,153,0.8)] active:translate-y-0 transition-all duration-300 text-center flex items-center justify-center gap-3 tracking-wider uppercase text-xs">
                            Get A Free Proposal
                            <i class="fa-solid fa-arrow-right animate-bounce-horizontal"></i>
                        </a>
                        <a href="#estimator" class="px-8 py-4.5 glass-card text-white font-extrabold rounded-xl hover:bg-white/10 hover:-translate-y-1 active:translate-y-0 transition-all duration-300 text-center text-xs uppercase tracking-wider">
                            Calculate Your Price
                        </a>
                    </div>
                    
                    <div class="flex items-center gap-6 text-xs text-jsos-darkGreyText font-medium pt-4 border-t border-white/5 max-w-md">
                        <p class="flex items-center gap-2"><i class="fa-solid fa-check text-jsos-purpleLight"></i> No Upfront Hidden Costs</p>
                        <p class="flex items-center gap-2"><i class="fa-solid fa-check text-jsos-purpleLight"></i> Bespoke Essex Engineering</p>
                    </div>
                </div>

                <div class="lg:col-span-5 relative hidden lg:block animate-on-scroll fade-in-right">
                    <div class="relative w-full aspect-square max-w-[460px] mx-auto interactive-hover-card">
                        <div class="absolute inset-0 bg-jsos-purple/20 rounded-3xl rotate-3 blur-md z-0 transition-transform duration-500 card-glow-layer"></div>
                        <div class="absolute inset-2 glass-card rounded-3xl p-8 flex flex-col gap-6 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.8)] border border-white/10 z-20 overflow-hidden">
                            <div class="flex items-center justify-between border-b border-white/5 pb-4">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
                                </div>
                                <span class="text-[10px] px-3 py-1 bg-green-400/10 text-green-400 rounded-full font-bold tracking-wider uppercase border border-green-500/20">100% Mobile Optimized</span>
                            </div>
                            
                            <div class="font-mono text-sm space-y-4 flex-1 select-none text-jsos-grey leading-relaxed">
                                <p class="text-jsos-purpleLight font-bold">&lt;LocalBusiness&gt;</p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Fast Loading Speed:</span> <span class="text-green-400 font-bold">Excellent</span></p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Google Lighthouse SEO:</span> <span class="text-green-400 font-bold">100/100</span></p>
                                <p class="text-blue-300/90 pl-4 flex justify-between"><span>Core Web Vitals:</span> <span class="text-green-400 font-bold">Passed</span></p>
                                <p class="text-jsos-purpleLight font-bold">&lt;/LocalBusiness&gt;</p>
                                
                                <div class="pt-6 border-t border-white/5 flex justify-between items-center text-[10px] uppercase tracking-wider font-sans font-bold text-jsos-darkGreyText">
                                    <span class="text-emerald-400 flex items-center gap-1.5">
                                        <i class="fa-solid fa-shield-halved"></i> Enterprise Secure
                                    </span>
                                    <span class="text-white">UK Maintained</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="services" class="py-36 relative bg-jsos-darkgrey/70 border-y border-white/5 overflow-hidden">
            <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-jsos-purple/5 rounded-full blur-[140px] pointer-events-none"></div>
            
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-28 animate-on-scroll">
                    <span class="watermark-text">SERVICES</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">WHAT WE DELIVER</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Everything You Need to Win Online</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-8">
                    <div class="glass-card p-10 rounded-2xl transition-all duration-500 group border border-white/5 relative overflow-hidden interactive-hover-card animate-on-scroll fade-in-up">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:bg-jsos-purple group-hover:scale-110 transition-all duration-300 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-bolt text-xl text-jsos-purpleLight group-hover:text-white transition-colors"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Lightning-Fast Infrastructure</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm">
                            Most template configurations are weighted down by bad code and bulky plugins. We design websites cleanly from the engine up, scoring unmatched loading times that maximize client retention.
                        </p>
                    </div>

                    <div class="glass-card p-10 rounded-2xl transition-all duration-500 group border border-white/5 relative overflow-hidden interactive-hover-card animate-on-scroll定位 fade-in-up" style="animation-delay: 150ms;">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:bg-jsos-purple group-hover:scale-110 transition-all duration-300 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-basket-shopping text-xl text-jsos-purpleLight group-hover:text-white transition-colors"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Seamless E-Commerce</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm">
                            Ready to collect immediate consumer deposits, secure digital client checkouts, or optimize scheduling logic? We deploy ultra-clean, high-availability booking frameworks explicitly built to convert.
                        </p>
                    </div>

                    <div class="glass-card p-10 rounded-2xl transition-all duration-500 group border border-white/5 relative overflow-hidden interactive-hover-card animate-on-scroll fade-in-up" style="animation-delay: 300ms;">
                        <div class="w-14 h-14 bg-jsos-purple/20 border border-jsos-purple/30 rounded-xl flex items-center justify-center mb-8 group-hover:bg-jsos-purple group-hover:scale-110 transition-all duration-300 shadow-[0_0_15px_rgba(102,51,153,0.2)]">
                            <i class="fa-solid fa-shield-halved text-xl text-jsos-purpleLight group-hover:text-white transition-colors"></i>
                        </div>
                        <h4 class="text-2xl font-bold mb-4 font-heading text-white tracking-tight">Bulletproof Systems Security</h4>
                        <p class="text-jsos-grey leading-relaxed font-medium text-sm">
                            Leveraging enterprise systems engineering blueprints, we shield your hosting surface, eliminating server vulnerabilities and malicious script injections before they can start.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="blueprint" class="py-36 relative bg-gradient-to-br from-jsos-black via-[#120a1c] to-jsos-black overflow-hidden">
            <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
                <div class="space-y-6 animate-on-scroll fade-in-left">
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs">OUR STRICT FRAMEWORK</h2>
                    <h3 class="text-4xl md:text-5xl font-black text-white font-heading leading-tight">Built to Stand Alone. <br/>Engineered to Dominate.</h3>
                    <p class="text-jsos-grey font-medium leading-relaxed">
                        We don't use dragging templates, bloated themes, or cheap visual editors that produce messy code structures. We engineer custom architectures built to provide real speed, elite security, and visible local growth.
                    </p>
                    
                    <div class="space-y-4 pt-4">
                        <div class="flex gap-4 items-start">
                            <div class="w-6 h-6 rounded-full bg-jsos-purple/30 border border-jsos-purpleLight/40 flex items-center justify-center text-jsos-purpleLight mt-1 text-xs shrink-0"><i class="fa-solid fa-code"></i></div>
                            <div>
                                <h4 class="text-white font-bold text-base">Hand-Coded Performance Integration</h4>
                                <p class="text-jsos-darkGreyText text-sm mt-1">Semantic source files maximize browser readability scores, leading directly to premium search indexing priorities.</p>
                            </div>
                        </div>
                        <div class="flex gap-4 items-start">
                            <div class="w-6 h-6 rounded-full bg-jsos-purple/30 border border-jsos-purpleLight/40 flex items-center justify-center text-jsos-purpleLight mt-1 text-xs shrink-0"><i class="fa-solid fa-magnifying-glass"></i></div>
                            <div>
                                <h4 class="text-white font-bold text-base">Bespoke Local Visibility Mechanics</h4>
                                <p class="text-jsos-darkGreyText text-sm mt-1">Deep on-page metadata optimization engineered directly around competitive local regional query frameworks.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="relative grid grid-cols-2 gap-4 animate-on-scroll fade-in-right">
                    <div class="space-y-4">
                        <div class="glass-card p-6 rounded-2xl border border-white/5 translate-y-8">
                            <span class="text-3xl font-black text-jsos-purpleLight font-heading">100%</span>
                            <p class="text-white font-bold text-sm mt-1">Data Sovereignty</p>
                            <p class="text-jsos-darkGreyText text-xs mt-1">Total operational independence over your source configuration assets.</p>
                        </div>
                        <div class="glass-card p-6 rounded-2xl border border-white/5 translate-y-8">
                            <span class="text-3xl font-black text-jsos-purpleLight font-heading">&lt;0.4s</span>
                            <p class="text-white font-bold text-sm mt-1">Average Response</p>
                            <p class="text-jsos-darkGreyText text-xs mt-1">Lightning response parameters on any mobile device viewport.</p>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <div class="glass-card p-6 rounded-2xl border border-white/5">
                            <span class="text-3xl font-black text-jsos-purpleLight font-heading">Zero</span>
                            <p class="text-white font-bold text-sm mt-1">Database Reliance</p>
                            <p class="text-jsos-darkGreyText text-xs mt-1">Static build mechanics ensure zero security exploit surfaces.</p>
                        </div>
                        <div class="glass-card p-6 rounded-2xl border border-white/5">
                            <span class="text-3xl font-black text-jsos-purpleLight font-heading">24/7</span>
                            <p class="text-white font-bold text-sm mt-1">Active Guarding</p>
                            <p class="text-jsos-darkGreyText text-xs mt-1">Monitored deployments mean no broken updates over weekends.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="process" class="py-36 relative bg-jsos-black border-t border-white/5">
            <div class="max-w-7xl mx-auto px-6">
                <div class="watermark-container text-center mb-24 animate-on-scroll">
                    <span class="watermark-text">SIMPLE</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">OUR ROADMAP</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Getting Started is Simple</h3>
                </div>

                <div class="grid md:grid-cols-3 gap-8 relative z-10">
                    <div class="glass-card p-8 rounded-2xl border border-white/5 relative group animate-on-scroll fade-in-up">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)] group-hover:scale-110 transition-transform">
                            1
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Configure Your Scope</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed font-medium">
                            Utilize our transparent blueprint investment module below to custom configure your operational requirements and scaling parameters in real time.
                        </p>
                    </div>

                    <div class="glass-card p-8 rounded-2xl border border-white/5 relative group animate-on-scroll fade-in-up" style="animation-delay: 150ms;">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)] group-hover:scale-110 transition-transform">
                            2
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Lock In Parameters</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed font-medium">
                            Submit your verified calculator dashboard report or connect via one-click WhatsApp. We'll verify your specifications through a straightforward consulting review session.
                        </p>
                    </div>

                    <div class="glass-card p-8 rounded-2xl border border-white/5 relative group animate-on-scroll fade-in-up" style="animation-delay: 300ms;">
                        <div class="absolute -top-5 left-8 bg-jsos-purple text-white w-10 h-10 rounded-xl flex items-center justify-center font-black border border-jsos-purpleLight/20 text-lg shadow-[0_4px_15px_rgba(102,51,153,0.4)] group-hover:scale-110 transition-transform">
                            3
                        </div>
                        <h4 class="text-xl font-bold text-white mb-3 mt-2 font-heading tracking-tight">Hands-Off Production</h4>
                        <p class="text-sm text-jsos-grey leading-relaxed font-medium">
                            While we implement the clean architecture blueprint, execute edge optimization protocols, and lock down secure hosting paths, you remain completely focused on scaling business operations.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section id="estimator" class="py-36 relative bg-jsos-darkgrey/40 border-t border-white/5">
            <div class="max-w-5xl mx-auto px-6">
                <div class="watermark-container text-center mb-20 animate-on-scroll">
                    <span class="watermark-text">INVESTMENT</span>
                    <h2 class="text-jsos-purpleLight font-bold uppercase tracking-widest text-xs mb-4">TRANSPARENT VALUE</h2>
                    <h3 class="text-4xl md:text-5xl font-extrabold text-white font-heading relative z-10">Build Your Deployment Plan</h3>
                </div>

                <div class="glass-card p-8 md:p-12 rounded-3xl border border-white/10 space-y-8 relative overflow-hidden animate-on-scroll fade-in-up">
                    <p class="text-center text-jsos-grey text-base font-medium max-w-xl mx-auto">Adjust the operational parameters below to generate an analytical development estimate tailored to your company's scaling needs.</p>
                    
                    <div class="grid md:grid-cols-12 gap-12 pt-4 items-center">
                        <div class="md:col-span-7 space-y-8">
                            <div>
                                <label class="flex justify-between items-center text-xs font-bold uppercase tracking-widest text-white mb-4" id="pageLabel" for="pageRange">
                                    <span>Core Informational Pages:</span>
                                    <span class="text-jsos-purpleLight text-xl font-black bg-jsos-purple/10 border border-jsos-purple/30 px-3 py-1 rounded-lg" id="pageValue">5</span>
                                </label>
                                <div class="relative flex items-center py-2">
                                    <input type="range" min="1" max="25" value="5" class="w-full h-2 bg-white/10 rounded-lg appearance-none cursor-pointer accent-jsos-purpleLight focus:outline-none focus:ring-2 focus:ring-jsos-purpleLight/50" id="pageRange">
                                </div>
                                <div class="flex justify-between text-[10px] text-jsos-darkGreyText mt-2 font-bold tracking-wider uppercase">
                                    <span>1 Single Page</span>
                                    <span>12 Core Layouts</span>
                                    <span>25 Massive Platform</span>
                                </div>
                            </div>

                            <div class="space-y-4">
                                <span class="block text-xs font-bold uppercase tracking-widest text-white mb-2">Integrated Platform Functionality</span>
                                <div class="grid gap-3">
                                    <label class="flex items-center gap-4 p-4 bg-jsos-black/40 hover:bg-white/[0.03] border border-white/5 hover:border-jsos-purpleLight/30 rounded-xl cursor-pointer transition-all duration-200 select-none">
                                        <input type="checkbox" id="ecommerceOpt" class="w-5 h-5 rounded text-jsos-purple accent-jsos-purpleLight cursor-pointer">
                                        <div class="flex-1">
                                            <span class="block text-sm font-bold text-white leading-none">Online Checkout & Multi-Channel Booking</span>
                                            <span class="block text-xs text-jsos-purpleLight font-bold mt-1">+£950 Add-on Architecture</span>
