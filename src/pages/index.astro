    <!-- Interactive JS Core Logic -->
    <script>
        // Update year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Nav Logic
        const mobileMenuButton = document.getElementById('mobileMenuButton');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Typing Loop Animation
        const phraseArray = ["Bespoke Performance", "Lightning Speed", "Maximum SEO Impact"];
        let count = 0;
        let index = 0;
        let currentText = "";
        let letter = "";
        (function type() {
            if (count === phraseArray.length) {
                count = 0;
            }
            currentText = phraseArray[count];
            letter = currentText.slice(0, ++index);

            document.getElementById('typingText').textContent = letter;
            if (letter.length === currentText.length) {
                setTimeout(() => {
                    index = 0;
                    count++;
                    setTimeout(type, 1000);
                }, 1500);
            } else {
                setTimeout(type, 100);
            }
        }());

        // Estimator Tool Real-time Interactive Logic
        const pageRange = document.getElementById('pageRange');
        const pageValue = document.getElementById('pageValue');
        const ecommerceOpt = document.getElementById('ecommerceOpt');
        const cmsOpt = document.getElementById('cmsOpt');
        const seoOpt = document.getElementById('seoOpt');
        const estimatedTotal = document.getElementById('estimatedTotal');

        function calculateEstimates() {
            const pages = parseInt(pageRange.value);
            pageValue.textContent = pages;
            
            let baseRate = 450; // Entry fee
            let costPerPage = 130;
            
            let total = baseRate + (pages * costPerPage);
            
            if (ecommerceOpt.checked) total += 950;
            if (cmsOpt.checked) total += 600;
            if (seoOpt.checked) total += 350;

            estimatedTotal.textContent = "£" + total.toLocaleString('en-GB');
        }

        pageRange.addEventListener('input', calculateEstimates);
        ecommerceOpt.addEventListener('change', calculateEstimates);
        cmsOpt.addEventListener('change', calculateEstimates);
        seoOpt.addEventListener('change', calculateEstimates);

        // Portfolio filtering logic matching Whit Group controls
        const filterButtons = document.querySelectorAll('.portfolio-filter-btn');
        const portfolioItems = document.querySelectorAll('.portfolio-grid-item');

        filterButtons.forEach(button => {
            button.addEventListener('click', () => {
                // Reset states
                filterButtons.forEach(btn => {
                    btn.classList.remove('bg-jsos-purple', 'text-white');
                    btn.classList.add('border-white/10', 'text-jsos-grey');
                });
                
                // Set active states
                button.classList.add('bg-jsos-purple', 'text-white');
                button.classList.remove('border-white/10', 'text-jsos-grey');

                const filterVal = button.getAttribute('data-filter');

                portfolioItems.forEach(item => {
                    if (filterVal === 'all' || item.getAttribute('data-category') === filterVal) {
                        item.style.display = 'block';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });

        // Interactive Polygonal Background Animation (replaces video backgrounds with smooth interactive CPU rendering)
        const canvas = document.getElementById('polygonCanvas');
        const ctx = canvas.getContext('2d');
        let points = [];
        const numPoints = 60;
        const maxDist = 120;

        function initCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            points = [];
            for (let i = 0; i < numPoints; i++) {
                points.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.4,
                    vy: (Math.random() - 0.5) * 0.4,
                    r: Math.random() * 2 + 1
                });
            }
        }

        function drawPoints() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // Draw lines
            for (let i = 0; i < points.length; i++) {
                for (let j = i + 1; j < points.length; j++) {
                    const dist = Math.hypot(points[i].x - points[j].x, points[i].y - points[j].y);
                    if (dist < maxDist) {
                        const alpha = (1 - dist / maxDist) * 0.15;
                        ctx.strokeStyle = `rgba(102, 51, 153, ${alpha})`;
                        ctx.lineWidth = 1;
                        ctx.beginPath();
                        ctx.moveTo(points[i].x, points[i].y);
                        ctx.lineTo(points[j].x, points[j].y);
                        ctx.stroke();
                    }
                }
            }

            // Move points
            points.forEach(p => {
                p.x += p.vx;
                p.y += p.vy;

                if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

                ctx.fillStyle = 'rgba(102, 51, 153, 0.4)';
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fill();
            });

            requestAnimationFrame(drawPoints);
        }

        window.addEventListener('resize', initCanvas);
        initCanvas();
        drawPoints();

        // Contact Form Submission Action (Clean UI Modal Transitions)
        const contactForm = document.getElementById('jsosContactForm');
        const formWrapper = document.getElementById('contactFormWrapper');
        const successState = document.getElementById('formSuccessState');

        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            formWrapper.classList.add('hidden');
            successState.classList.remove('hidden');
        });

        function resetContactForm() {
            contactForm.reset();
            successState.classList.add('hidden');
            formWrapper.classList.remove('hidden');
            calculateEstimates();
        }
    </script>
